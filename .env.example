# ── App ──────────────────────────────────────────────────
APP_NAME=auxilio-mecanico-backend
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auxilio_mecanico
DB_SCHEMA=auxilio_mecanico

# ── Security ─────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AWS / S3 ─────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=auxilio-mecanico-evidences

# ── Firebase ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── VPAY ─────────────────────────────────────────────────
VPAY_BASE_URL=https://vpay.com.bo:7778/pro
VPAY_TOKEN=your-vpay-jwt-token
VPAY_DESTINATION_ACCOUNT=your-destination-account
VPAY_BANK=BMSC
VPAY_USER=your-vpay-user
VPAY_COMPANY=your-company-id
VPAY_VERIFY_SSL=false
